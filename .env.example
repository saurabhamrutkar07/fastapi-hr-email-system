# Copy this file to .env and fill in your own values. Never commit .env.
# Full list and explanations: README.md -> "Environment variables"

# --- Database ---
# Without Docker: your local PostgreSQL
DATABASE_URL=postgresql+asyncpg://postgres:password@localhost:5432/coldreach
# With Docker: password for the Postgres container (DATABASE_URL is built for you)
POSTGRES_PASSWORD=change-me

# --- Secrets ---
# python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=change-me
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=change-me

# --- Gmail account that sends OTP emails (use a Gmail app password) ---
EMAIL_ADDRESS=you@gmail.com
EMAIL_PASSWORD=your-app-password

# --- S3 bucket for resumes ---
S3_BUCKET_NAME=your-bucket
AWS_REGION=ap-south-1
# Laptop only. On EC2 leave both out so the IAM role is used.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# --- Google sign-in ---
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-client-secret
# Without Docker:
GOOGLE_REDIRECT_URI=http://localhost:8000/auth/google/callback
FRONTEND_URL=http://localhost:3000
# With Docker (sets the two above):
# PUBLIC_URL=http://localhost:8080

# --- Optional ---
APP_ENV=development
# false only for plain-HTTP local use
COOKIE_SECURE=false
SENTRY_DSN=
